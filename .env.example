# API keys are normally entered through the app's Settings panel and stored
# locally in SQLite (never exposed to the renderer). These env vars are only a
# convenience fallback read by the main process on first launch.
PA_PROVIDER=anthropic            # "anthropic" | "openai"
PA_MODEL=claude-3-5-sonnet-latest
PA_API_KEY=
# Whisper transcription always uses OpenAI. Optional if you don't use voice.
PA_OPENAI_TRANSCRIBE_KEY=
